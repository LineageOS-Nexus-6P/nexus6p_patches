+    /**
+     * Serialize legacy IMS and default setup so QCRIL never receives both requests concurrently.
+     */
+    @VisibleForTesting
+    boolean shouldDeferInternetUntilLegacyIms(@NonNull DataProfile dataProfile) {
+        if (!mDataConfigManager.isLegacyImsInternetMergeEnabled()
+                || !dataProfile.canSatisfy(NetworkCapabilities.NET_CAPABILITY_INTERNET)
+                || dataProfile.canSatisfy(NetworkCapabilities.NET_CAPABILITY_IMS)) {
+            return false;
+        }
+
+        boolean imsConnected = mDataNetworkList.stream().anyMatch(dataNetwork ->
+                dataNetwork.isConnected()
+                        && dataNetwork.getDataProfile().canSatisfy(
+                                NetworkCapabilities.NET_CAPABILITY_IMS));
+        if (imsConnected) {
+            removeMessages(EVENT_LEGACY_IMS_FIRST_TIMEOUT);
+            mLegacyImsFirstGateStarted = false;
+            mLegacyImsFirstGateOpen = true;
+            return false;
+        }
+
+        if (mLegacyImsFirstGateOpen) {
+            return false;
+        }
+
+        if (!mLegacyImsFirstGateStarted) {
+            mLegacyImsFirstGateStarted = true;
+            sendEmptyMessageDelayed(EVENT_LEGACY_IMS_FIRST_TIMEOUT,
+                    LEGACY_IMS_FIRST_TIMEOUT_MILLIS);
+            logl("Legacy IMS-first gate: defer default data until IMS connects or timeout");
+        }
+        return true;
+    }
+
+    /** Reset the IMS-first gate for the next radio/SIM attach cycle. */
+    private void resetLegacyImsFirstGate() {
+        removeMessages(EVENT_LEGACY_IMS_FIRST_TIMEOUT);
+        mLegacyImsFirstGateStarted = false;
+        mLegacyImsFirstGateOpen = false;
+    }
