+    /**
+     * Angler's legacy RIL can fold a default bearer into the already active IMS CID. In that
+     * case INTERNET and the derived NOT_RESTRICTED capability are added to the same physical
+     * network. Replacing the NetworkAgent for that capability-only transition changes the Android
+     * Network handle and forces the IMS stack to tear down an otherwise healthy SIP/RTP session.
+     */
+    private boolean isLegacyImsInternetCapabilityTransition(
+            @NonNull NetworkCapabilities oldCapabilities,
+            @NonNull NetworkCapabilities newCapabilities) {
+        if (!mDataConfigManager.isLegacyImsInternetMergeEnabled()
+                || !mDataProfile.canSatisfy(NetworkCapabilities.NET_CAPABILITY_IMS)
+                || oldCapabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)
+                == newCapabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)) {
+            return false;
+        }
+
+        List<Integer> oldCapabilitiesWithoutLegacyMerge = Arrays.stream(
+                oldCapabilities.getCapabilities()).boxed().collect(Collectors.toList());
+        oldCapabilitiesWithoutLegacyMerge.removeAll(MUTABLE_CAPABILITIES);
+        oldCapabilitiesWithoutLegacyMerge.remove(Integer.valueOf(
+                NetworkCapabilities.NET_CAPABILITY_INTERNET));
+        oldCapabilitiesWithoutLegacyMerge.remove(Integer.valueOf(
+                NetworkCapabilities.NET_CAPABILITY_NOT_RESTRICTED));
+
+        List<Integer> newCapabilitiesWithoutLegacyMerge = Arrays.stream(
+                newCapabilities.getCapabilities()).boxed().collect(Collectors.toList());
+        newCapabilitiesWithoutLegacyMerge.removeAll(MUTABLE_CAPABILITIES);
+        newCapabilitiesWithoutLegacyMerge.remove(Integer.valueOf(
+                NetworkCapabilities.NET_CAPABILITY_INTERNET));
+        newCapabilitiesWithoutLegacyMerge.remove(Integer.valueOf(
+                NetworkCapabilities.NET_CAPABILITY_NOT_RESTRICTED));
+
+        return oldCapabilitiesWithoutLegacyMerge.size()
+                == newCapabilitiesWithoutLegacyMerge.size()
+                && oldCapabilitiesWithoutLegacyMerge.containsAll(
+                        newCapabilitiesWithoutLegacyMerge);
+    }
