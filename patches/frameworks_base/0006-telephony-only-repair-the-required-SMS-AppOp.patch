+++ b/tests/TelephonyCommonTests/src/com/android/internal/telephony/tests/SmsApplicationTest.java
@@ -26,6 +26,7 @@ import static org.mockito.ArgumentMatchers.matches;
 import static org.mockito.ArgumentMatchers.nullable;
 import static org.mockito.Mockito.atLeastOnce;
 import static org.mockito.Mockito.doAnswer;
+import static org.mockito.Mockito.never;
 import static org.mockito.Mockito.times;
 import static org.mockito.Mockito.verify;
 import static org.mockito.Mockito.when;
@@ -210,6 +211,29 @@ public class SmsApplicationTest {
                 AppOpsManager.MODE_ALLOWED);
     }
 
+    @Test
+    public void testGrantPermissionsToSystemAppsOnlySetsWriteSmsForPhonePackage()
+            throws Exception {
+        setupPackageInfosForCoreApps();
+        when(mAppOpsManager.unsafeCheckOp(AppOpsManager.OPSTR_WRITE_SMS, FAKE_PHONE_UID,
+                SmsApplication.PHONE_PACKAGE_NAME)).thenReturn(AppOpsManager.MODE_IGNORED);
+
+        SmsApplication.grantPermissionsToSystemApps(mContext);
+
+        verify(mAppOpsManager).setUidMode(AppOpsManager.OPSTR_WRITE_SMS,
+                FAKE_PHONE_UID, AppOpsManager.MODE_ALLOWED);
+        verify(mAppOpsManager, never()).setUidMode(AppOpsManager.OPSTR_READ_SMS,
+                FAKE_PHONE_UID, AppOpsManager.MODE_ALLOWED);
+        verify(mAppOpsManager, never()).setUidMode(AppOpsManager.OPSTR_RECEIVE_SMS,
+                FAKE_PHONE_UID, AppOpsManager.MODE_ALLOWED);
+        verify(mAppOpsManager, never()).setUidMode(AppOpsManager.OPSTR_RECEIVE_WAP_PUSH,
+                FAKE_PHONE_UID, AppOpsManager.MODE_ALLOWED);
+        verify(mAppOpsManager, never()).setUidMode(AppOpsManager.OPSTR_SEND_SMS,
+                FAKE_PHONE_UID, AppOpsManager.MODE_ALLOWED);
+        verify(mAppOpsManager, never()).setUidMode(AppOpsManager.OPSTR_READ_CELL_BROADCASTS,
+                FAKE_PHONE_UID, AppOpsManager.MODE_ALLOWED);
+    }
+
     @Test
     public void testPackageChanged() throws Exception {
