From c44e1bf16ac0f9761f20de37141459a2e0cab163 Mon Sep 17 00:00:00 2001
From: derveror <derveror@gmail.com>
Date: Sun, 11 Oct 2026 18:16:58 -0400
Subject: [PATCH 1/6] SystemUI: ignore non-plugin package reloads

---
 .../shared/plugins/PluginManagerTest.java     | 29 +++++++++++++++++++
 .../shared/plugins/PluginManagerImpl.java     | 17 +++++++++--
 2 files changed, 43 insertions(+), 3 deletions(-)

diff --git a/packages/SystemUI/multivalentTests/src/com/android/systemui/shared/plugins/PluginManagerTest.java b/packages/SystemUI/multivalentTests/src/com/android/systemui/shared/plugins/PluginManagerTest.java
index c721ceb10f86..0428ac12ba7b 100644
--- a/packages/SystemUI/multivalentTests/src/com/android/systemui/shared/plugins/PluginManagerTest.java
+++ b/packages/SystemUI/multivalentTests/src/com/android/systemui/shared/plugins/PluginManagerTest.java
@@ -18,6 +18,7 @@ import static org.mockito.Mockito.any;
 import static org.mockito.Mockito.atLeastOnce;
 import static org.mockito.Mockito.eq;
 import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
 import static org.mockito.Mockito.verify;
 import static org.mockito.Mockito.when;
 
@@ -78,6 +79,9 @@ public class PluginManagerTest extends SysuiTestCase {
         MockitoAnnotations.initMocks(this);
         when(mMockFactory.create(any(), any(), eq(TestPlugin.class), anyBoolean(), anyBoolean()))
                 .thenReturn(mMockPluginInstance);
+        mContext.setMockPackageManager(mMockPackageManager);
+        when(mMockPackageManager.checkPermission(any(), any()))
+                .thenReturn(PackageManager.PERMISSION_DENIED);
 
         mPluginManager = new PluginManagerImpl(
                 getContext(), mMockFactory, true,
@@ -182,6 +186,31 @@ public class PluginManagerTest extends SysuiTestCase {
                 PluginEnabler.DISABLED_INVALID_VERSION);
     }
 
+    @Test
+    public void testPackageChanged_withoutPluginPermission_doesNotReloadPlugins() {
+        mPluginManager.addPluginListener("myAction", mMockListener, TestPlugin.class);
+
+        Intent intent = new Intent(Intent.ACTION_PACKAGE_CHANGED)
+                .setData(Uri.parse("package:com.android.regularapp"));
+        mPluginManager.onReceive(mContext, intent);
+
+        verify(mMockPluginInstance, never()).reloadPackage("com.android.regularapp");
+    }
+
+    @Test
+    public void testPackageChanged_withPluginPermission_reloadsPlugins() {
+        when(mMockPackageManager.checkPermission(
+                PluginActionManager.PLUGIN_PERMISSION, "com.android.plugin"))
+                .thenReturn(PackageManager.PERMISSION_GRANTED);
+        mPluginManager.addPluginListener("myAction", mMockListener, TestPlugin.class);
+
+        Intent intent = new Intent(Intent.ACTION_PACKAGE_CHANGED)
+                .setData(Uri.parse("package:com.android.plugin"));
+        mPluginManager.onReceive(mContext, intent);
+
+        verify(mMockPluginInstance).reloadPackage("com.android.plugin");
+    }
+
     private void captureExceptionHandler() {
         verify(mMockExPreHandlerManager, atLeastOnce()).registerHandler(
                 mExPreHandlerCaptor.capture());
diff --git a/packages/SystemUI/shared/src/com/android/systemui/shared/plugins/PluginManagerImpl.java b/packages/SystemUI/shared/src/com/android/systemui/shared/plugins/PluginManagerImpl.java
index 9a264c6ca414..18f66fb3f167 100644
--- a/packages/SystemUI/shared/src/com/android/systemui/shared/plugins/PluginManagerImpl.java
+++ b/packages/SystemUI/shared/src/com/android/systemui/shared/plugins/PluginManagerImpl.java
@@ -20,6 +20,7 @@ import android.content.ComponentName;
 import android.content.Context;
 import android.content.Intent;
 import android.content.IntentFilter;
+import android.content.pm.PackageManager;
 import android.net.Uri;
 import android.os.Build;
 import android.os.SystemProperties;
@@ -194,10 +195,20 @@ public class PluginManagerImpl extends BroadcastReceiver implements PluginManage
                     mPluginEnabler.setEnabled(componentName);
                 }
             }
+            final boolean isReload = Intent.ACTION_PACKAGE_ADDED.equals(intent.getAction())
+                    || Intent.ACTION_PACKAGE_CHANGED.equals(intent.getAction())
+                    || Intent.ACTION_PACKAGE_REPLACED.equals(intent.getAction());
+
+            // Every plugin is required to hold PLUGIN_PERMISSION. Avoid scheduling one
+            // PackageManager query per registered plugin action for ordinary package broadcasts.
+            // This is especially important during the package-change burst after an OTA.
+            if (isReload && mContext.getPackageManager().checkPermission(
+                    PluginActionManager.PLUGIN_PERMISSION, pkg)
+                    != PackageManager.PERMISSION_GRANTED) {
+                return;
+            }
             synchronized (this) {
-                if (Intent.ACTION_PACKAGE_ADDED.equals(intent.getAction())
-                        || Intent.ACTION_PACKAGE_CHANGED.equals(intent.getAction())
-                        || Intent.ACTION_PACKAGE_REPLACED.equals(intent.getAction())) {
+                if (isReload) {
                     for (PluginActionManager<?> actionManager : mPluginMap.values()) {
                         actionManager.reloadPackage(pkg);
                     }
