     }
 
+    @Test
+    public void testUserUnlockedDoesNotWaitForShortcutRegistration() throws Exception {
+        CountDownLatch registrationStarted = new CountDownLatch(1);
+        CountDownLatch releaseRegistration = new CountDownLatch(1);
+        doAnswer(invocation -> {
+            registrationStarted.countDown();
+            releaseRegistration.await(5, TimeUnit.SECONDS);
+            return null;
+        }).when(mShortcutServiceInternal).addShortcutChangeCallback(any());
+
+        ExecutorService executor = Executors.newSingleThreadExecutor();
+        Future<?> lifecycleCall = executor.submit(() -> mPeopleService.onUserUnlocked(
+                new SystemService.TargetUser(new UserInfo(USER_ID, "test", 0))));
+        try {
+            lifecycleCall.get(1, TimeUnit.SECONDS);
+            assertThat(registrationStarted.await(1, TimeUnit.SECONDS)).isTrue();
+        } finally {
+            releaseRegistration.countDown();
+            executor.shutdownNow();
+        }
+    }
