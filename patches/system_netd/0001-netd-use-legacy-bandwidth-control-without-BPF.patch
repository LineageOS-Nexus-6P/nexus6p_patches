From 7bf69c48a8a1400b5c1ecda6fff3d8ffe2d3b2b2 Mon Sep 17 00:00:00 2001
From: derveror <derveror@gmail.com>
Date: Sun, 11 Oct 2026 17:31:34 -0400
Subject: [PATCH] netd: use legacy bandwidth control without BPF

Change-Id: I46845596c174616ec7ab0db689876ab656a43bd9
---
 server/BandwidthController.cpp     | 45 ++++++++++++++++++++++--------
 server/BandwidthController.h       |  2 ++
 server/BandwidthControllerTest.cpp | 38 +++++++++++++++++++++++--
 server/Controllers.cpp             |  6 +++-
 4 files changed, 77 insertions(+), 14 deletions(-)

diff --git a/server/BandwidthController.cpp b/server/BandwidthController.cpp
index 8a967387..7067ded0 100644
--- a/server/BandwidthController.cpp
+++ b/server/BandwidthController.cpp
@@ -200,7 +200,7 @@ static const uint32_t uidBillingMask = Fwmark::getUidBillingMask();
  * See go/ipsec-data-accounting for more information.
  */
 
-std::vector<std::string> getBasicAccountingCommands() {
+std::vector<std::string> getBasicAccountingCommands(bool useBpfAccounting) {
     // clang-format off
     std::vector<std::string> ipt_basic_accounting_commands = {
             "*filter",
@@ -212,12 +212,22 @@ std::vector<std::string> getBasicAccountingCommands() {
                          uidBillingMask),
             StringPrintf("-A bw_INPUT -j MARK --or-mark 0x%x", uidBillingMask),
             "-A bw_OUTPUT -j bw_global_alert",
-            "-A bw_costly_shared -j bw_penalty_box",
-            ("-I bw_penalty_box -m bpf --object-pinned " XT_BPF_DENYLIST_PROG_PATH " -j REJECT"),
+            "-A bw_costly_shared -j bw_penalty_box"};
+    if (useBpfAccounting) {
+        ipt_basic_accounting_commands.push_back(
+                "-I bw_penalty_box -m bpf --object-pinned " XT_BPF_DENYLIST_PROG_PATH
+                " -j REJECT");
+    }
+    ipt_basic_accounting_commands.insert(ipt_basic_accounting_commands.end(), {
             "-A bw_penalty_box -j bw_happy_box",
             "-A bw_happy_box -j bw_data_saver",
-            "-A bw_data_saver -j RETURN",
-            ("-I bw_happy_box -m bpf --object-pinned " XT_BPF_ALLOWLIST_PROG_PATH " -j RETURN"),
+            "-A bw_data_saver -j RETURN"});
+    if (useBpfAccounting) {
+        ipt_basic_accounting_commands.push_back(
+                "-I bw_happy_box -m bpf --object-pinned " XT_BPF_ALLOWLIST_PROG_PATH
+                " -j RETURN");
+    }
+    ipt_basic_accounting_commands.insert(ipt_basic_accounting_commands.end(), {
             "COMMIT",
 
             "*raw",
@@ -236,7 +246,12 @@ std::vector<std::string> getBasicAccountingCommands() {
             //
             // Hence we will never double count and additional corrections are not needed.
             // We can simply take the sum of base and stacked (+20B/pkt) interface counts.
-            ("-A bw_raw_PREROUTING -m bpf --object-pinned " XT_BPF_INGRESS_PROG_PATH),
+    });
+    if (useBpfAccounting) {
+        ipt_basic_accounting_commands.push_back(
+                "-A bw_raw_PREROUTING -m bpf --object-pinned " XT_BPF_INGRESS_PROG_PATH);
+    }
+    ipt_basic_accounting_commands.insert(ipt_basic_accounting_commands.end(), {
             "COMMIT",
 
             "*mangle",
@@ -249,16 +264,24 @@ std::vector<std::string> getBasicAccountingCommands() {
             // This is egress interface accounting: we account 464xlat traffic only on
             // the clat interface (as offloaded packets never hit base interface's ip6tables)
             // and later sum base and stacked with overhead (+20B/pkt) in higher layers
-            ("-A bw_mangle_POSTROUTING -m bpf --object-pinned " XT_BPF_EGRESS_PROG_PATH),
-            COMMIT_AND_CLOSE};
+    });
+    if (useBpfAccounting) {
+        ipt_basic_accounting_commands.push_back(
+                "-A bw_mangle_POSTROUTING -m bpf --object-pinned " XT_BPF_EGRESS_PROG_PATH);
+    }
+    ipt_basic_accounting_commands.insert(ipt_basic_accounting_commands.end(), {
+            COMMIT_AND_CLOSE});
     // clang-format on
     return ipt_basic_accounting_commands;
 }
 
 }  // namespace
 
-BandwidthController::BandwidthController() {
-}
+BandwidthController::BandwidthController()
+    : BandwidthController(property_get_bool("ro.kernel.ebpf.supported", true)) {}
+
+BandwidthController::BandwidthController(bool useBpfAccounting)
+    : mUseBpfAccounting(useBpfAccounting) {}
 
 void BandwidthController::flushCleanTables(bool doClean) {
     /* Flush and remove the bw_costly_<iface> tables */
@@ -283,7 +306,7 @@ int BandwidthController::enableBandwidthControl() {
 
     flushCleanTables(false);
 
-    std::string commands = Join(getBasicAccountingCommands(), '\n');
+    std::string commands = Join(getBasicAccountingCommands(mUseBpfAccounting), '\n');
     return iptablesRestoreFunction(V4V6, commands, nullptr);
 }
 
diff --git a/server/BandwidthController.h b/server/BandwidthController.h
index bf89eb47..ccd41305 100644
--- a/server/BandwidthController.h
+++ b/server/BandwidthController.h
@@ -30,6 +30,7 @@ public:
     std::mutex lock;
 
     BandwidthController();
+    explicit BandwidthController(bool useBpfAccounting);
 
     int setupIptablesHooks();
 
@@ -120,6 +121,7 @@ public:
 
     int64_t mSharedQuotaBytes = 0;
     int64_t mGlobalAlertBytes = 0;
+    const bool mUseBpfAccounting;
 
     std::map<std::string, QuotaInfo> mQuotaIfaces;
     std::set<std::string> mSharedQuotaIfaces;
diff --git a/server/BandwidthControllerTest.cpp b/server/BandwidthControllerTest.cpp
index 546a738e..4bc98a42 100644
--- a/server/BandwidthControllerTest.cpp
+++ b/server/BandwidthControllerTest.cpp
@@ -200,10 +200,45 @@ TEST_F(BandwidthControllerTest, TestEnableBandwidthControl) {
             "COMMIT\n";
     // clang-format on
 
-    mBw.enableBandwidthControl();
+    BandwidthController bpfBw(true);
+    bpfBw.enableBandwidthControl();
     expectSetupCommands(expectedClean, expectedAccounting);
 }
 
+TEST_F(BandwidthControllerTest, TestEnableLegacyBandwidthControl) {
+    addIptablesRestoreOutput(
+            "-P OUTPUT ACCEPT\n"
+            "-N bw_costly_shared\n"
+            "-N unrelated\n");
+
+    static const std::string expectedAccounting =
+            "*filter\n"
+            "-A bw_INPUT -j bw_global_alert\n"
+            "-A bw_INPUT -p esp -j RETURN\n"
+            "-A bw_INPUT -m mark --mark 0x100000/0x100000 -j RETURN\n"
+            "-A bw_INPUT -j MARK --or-mark 0x100000\n"
+            "-A bw_OUTPUT -j bw_global_alert\n"
+            "-A bw_costly_shared -j bw_penalty_box\n"
+            "-A bw_penalty_box -j bw_happy_box\n"
+            "-A bw_happy_box -j bw_data_saver\n"
+            "-A bw_data_saver -j RETURN\n"
+            "COMMIT\n"
+            "*raw\n"
+            "-A bw_raw_PREROUTING -m mark --mark 0xdeadc1a7 -j DROP\n"
+            "-A bw_raw_PREROUTING -i ipsec+ -j RETURN\n"
+            "-A bw_raw_PREROUTING -m policy --pol ipsec --dir in -j RETURN\n"
+            "COMMIT\n"
+            "*mangle\n"
+            "-A bw_mangle_POSTROUTING -o ipsec+ -j RETURN\n"
+            "-A bw_mangle_POSTROUTING -m policy --pol ipsec --dir out -j RETURN\n"
+            "-A bw_mangle_POSTROUTING -j MARK --set-mark 0x0/0x100000\n"
+            "COMMIT\n";
+
+    BandwidthController legacyBw(false);
+    legacyBw.enableBandwidthControl();
+    expectSetupCommands("", expectedAccounting);
+}
+
 TEST_F(BandwidthControllerTest, TestEnableDataSaver) {
     mBw.enableDataSaver(true);
     std::string expected4 =
@@ -440,4 +475,3 @@ TEST_F(BandwidthControllerTest, CostlyAlert) {
     EXPECT_EQ(0, alertBytes);
     expectIptablesRestoreCommands(expected);
 }
-
diff --git a/server/Controllers.cpp b/server/Controllers.cpp
index ea348973..d0d95544 100644
--- a/server/Controllers.cpp
+++ b/server/Controllers.cpp
@@ -19,6 +19,7 @@
 #include <set>
 #include <string>
 
+#include <android-base/properties.h>
 #include <android-base/stringprintf.h>
 #include <android-base/strings.h>
 #include <netdutils/Stopwatch.h>
@@ -325,7 +326,10 @@ void Controllers::init() {
         // As such simply exit netd.  This may crash loop the system, but by failing
         // to bootup we will trigger rollback and thus this offers us protection against
         // a mainline update breaking things.
-        exit(1);
+        if (android::base::GetBoolProperty("ro.kernel.ebpf.supported", true)) {
+            exit(1);
+        }
+        gLog.warn("Continuing without BPF bandwidth accounting");
     }
     gLog.info("Enabling bandwidth control: %" PRId64 "us", s.getTimeAndResetUs());
 
-- 
2.43.0

