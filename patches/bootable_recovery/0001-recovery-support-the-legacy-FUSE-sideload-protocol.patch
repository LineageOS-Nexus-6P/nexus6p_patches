 #include "install/wipe_data.h"
 #include "minadbd/types.h"
 #include "otautil/sysutil.h"
@@ -102,7 +103,7 @@ static auto AdbInstallPackageHandler(Device* device, InstallResult* result) {
   for (int i = 0; i < ADB_INSTALL_TIMEOUT; ++i) {
     struct stat st;
     if (stat(FUSE_SIDELOAD_HOST_PATHNAME, &st) != 0) {
-      if (errno == ENOENT && i < ADB_INSTALL_TIMEOUT - 1) {
+      if (IsRetryableFuseStatError(errno) && i < ADB_INSTALL_TIMEOUT - 1) {
         sleep(1);
         continue;
       } else {
diff --git a/install/include/install/fuse_wait.h b/install/include/install/fuse_wait.h
new file mode 100644
index 0000000000000000000000000000000000000000..16527c896e5786467714c919f2b82f5a6692dd82
--- /dev/null
+++ b/install/include/install/fuse_wait.h
@@ -0,0 +1,26 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <errno.h>
+
+inline constexpr bool IsRetryableFuseStatError(int /* error */) {
+  // Legacy FUSE implementations may transiently return errors other than
+  // ENOENT while the mount is becoming ready. The caller's timeout bounds
+  // the retry period.
+  return true;
+}
diff --git a/tests/unit/fuse_sideload_test.cpp b/tests/unit/fuse_sideload_test.cpp
index ea895038c20851d9b73d44443a60b2727711dc45..f03d7394257e06967652217e6c09284b0f064248 100644
--- a/tests/unit/fuse_sideload_test.cpp
+++ b/tests/unit/fuse_sideload_test.cpp
@@ -25,12 +25,18 @@
 #include <gtest/gtest.h>
 
 #include "fuse_provider.h"
+#include "fuse_compat.h"
 #include "fuse_sideload.h"
 
 TEST(SideloadTest, fuse_device) {
   ASSERT_EQ(0, access("/dev/fuse", R_OK | W_OK));
 }
 
+TEST(SideloadTest, legacy_7_23_uses_compat_init_reply) {
+  EXPECT_EQ(FUSE_COMPAT_22_INIT_OUT_SIZE, FuseInitOutSizeForMinor(23));
+  EXPECT_EQ(sizeof(fuse_init_out), FuseInitOutSizeForMinor(24));
+}
+
 class FuseTestDataProvider : public FuseDataProvider {
  public:
   FuseTestDataProvider(uint64_t file_size, uint32_t block_size)
diff --git a/tests/unit/install_test.cpp b/tests/unit/install_test.cpp
index c3415479dfc2225f3c7c9fe3c2cc2f0fe507781d..e411b1a380760c84e55ac577b7cd3d15c9572920 100644
--- a/tests/unit/install_test.cpp
+++ b/tests/unit/install_test.cpp
@@ -32,6 +32,7 @@
 #include <ziparchive/zip_writer.h>
 
 #include "install/install.h"
+#include "install/fuse_wait.h"
 #include "install/wipe_device.h"
 #include "otautil/paths.h"
 #include "private/setup_commands.h"
@@ -50,6 +51,13 @@ static void BuildZipArchive(const std::map<std::string, std::string>& file_map,
   ASSERT_EQ(0, fclose(zip_file));
 }
 
+TEST(InstallTest, retries_while_legacy_kernel_finishes_fuse_mount) {
+  EXPECT_TRUE(IsRetryableFuseStatError(ENOENT));
+  EXPECT_TRUE(IsRetryableFuseStatError(ENOTCONN));
+  EXPECT_TRUE(IsRetryableFuseStatError(EIO));
+  EXPECT_TRUE(IsRetryableFuseStatError(EACCES));
+}
