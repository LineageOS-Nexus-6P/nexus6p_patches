  * |uid| is a Linux/Android UID to be queried. It is a combination of UserID and AppID.
  * |metered| indicates whether the uid is currently using a billing network.
  *
- * Returns 0(false)/1(true) on success, -EUNATCH when the ADnsHelper_init is not called before
- * calling this function. Returns a negative POSIX error code (see errno.h) on other failures
+ * Returns 0(false)/1(true) on success. Missing BPF maps are treated as unblocked networking only
+ * when ro.kernel.ebpf.supported=false. Returns -EUNATCH when the helper is uninitialized on an
+ * eBPF-capable device, or another negative POSIX error code (see errno.h) on other failures
  * that return from bpf syscall.
  */
 int ADnsHelper_isUidNetworkingBlocked(uid_t uid, bool metered);
diff --git a/bpf/headers/include/bpf/BpfMap.h b/bpf/headers/include/bpf/BpfMap.h
index 1037bebf29..7655a0e3ad 100644
--- a/bpf/headers/include/bpf/BpfMap.h
+++ b/bpf/headers/include/bpf/BpfMap.h
@@ -60,20 +60,37 @@ class BpfMapRO {
 
   protected:
     void abortOnMismatch(bool writable) const {
-        if (!mMapFd.ok()) abort();
+        // Legacy kernels may not provide Android networking eBPF maps at all.
+        // Missing or incompatible maps must be reported to the caller instead
+        // of aborting a process such as system_server.
+        if (!mMapFd.ok()) return;
         if (isAtLeastKernelVersion(4, 14, 0)) {
             int flags = bpfGetFdMapFlags(mMapFd);
-            if (flags < 0) abort();
-            if (flags & BPF_F_WRONLY) abort();
-            if (writable && (flags & BPF_F_RDONLY)) abort();
-            if (bpfGetFdKeySize(mMapFd) != sizeof(Key)) abort();
-            if (bpfGetFdValueSize(mMapFd) != sizeof(Value)) abort();
+            if (flags < 0) return;
+            if (flags & BPF_F_WRONLY) return;
+            if (writable && (flags & BPF_F_RDONLY)) return;
+            if (bpfGetFdKeySize(mMapFd) != sizeof(Key)) return;
+            if (bpfGetFdValueSize(mMapFd) != sizeof(Value)) return;
         }
     }
 
   public:
-    explicit BpfMapRO<Key, Value>(const char* pathname) {
+    bool isOk(bool writable = false) const {
+        if (!mMapFd.ok()) return false;
+        if (isAtLeastKernelVersion(4, 14, 0)) {
+            int flags = bpfGetFdMapFlags(mMapFd);
+            if (flags < 0) return false;
+            if (flags & BPF_F_WRONLY) return false;
+            if (writable && (flags & BPF_F_RDONLY)) return false;
+            if (bpfGetFdKeySize(mMapFd) != sizeof(Key)) return false;
+            if (bpfGetFdValueSize(mMapFd) != sizeof(Value)) return false;
+        }
+        return true;
+    }
+
+    explicit BpfMapRO<Key, Value>(const char* pathname, bool allowMissing = false) {
         mMapFd.reset(mapRetrieveRO(pathname));
+        if (allowMissing && !mMapFd.ok()) return;
         abortOnMismatch(/* writable */ false);
     }
 
@@ -233,8 +250,9 @@ class BpfMap : public BpfMapRO<Key, Value> {
 
     BpfMap<Key, Value>() {};
 
-    explicit BpfMap<Key, Value>(const char* pathname) {
+    explicit BpfMap<Key, Value>(const char* pathname, bool allowMissing = false) {
         mMapFd.reset(mapRetrieveRW(pathname));
+        if (allowMissing && !mMapFd.ok()) return;
         abortOnMismatch(/* writable */ true);
     }
 
