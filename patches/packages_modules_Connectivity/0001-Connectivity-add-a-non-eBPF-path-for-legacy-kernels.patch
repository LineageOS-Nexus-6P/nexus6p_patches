+++ b/bpf/loader/NetBpfLoad.cpp
@@ -63,6 +63,7 @@
 #define BPFLOADER_MAINLINE_VERSION 42u
 
 using android::base::EndsWith;
+using android::base::GetBoolProperty;
 using android::base::GetIntProperty;
 using android::base::GetProperty;
 using android::base::InitLogging;
@@ -1449,6 +1450,18 @@ static int doLoad(char** argv, char * const envp[]) {
         return 1;
     }
 
+    // Ultra-legacy devices may intentionally run without eBPF. The rest of
+    // Connectivity has a userspace fallback for this opt-out, so complete the
+    // boot trigger instead of forcing init into a reboot loop.
+    if (!GetBoolProperty("ro.kernel.ebpf.supported", true)) {
+        ALOGW("eBPF disabled by ro.kernel.ebpf.supported; skipping BPF program loading.");
+        if (!SetProperty("bpf.progs_loaded", "1")) {
+            ALOGE("Failed to set bpf.progs_loaded property to 1.");
+            return 125;
+        }
+        return 0;
+    }
+
     logTetheringApexVersion();
 
     if (!isAtLeastT) {
