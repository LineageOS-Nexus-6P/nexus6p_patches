       LOG.atInfo("Refusing to rebind since current state is already connected");
       return;
     }
+    if (context
+            .getPackageManager()
+            .resolveService(COMPAT_SERVICE_INTENT, PackageManager.MATCH_SYSTEM_ONLY)
+        == null) {
+      // AOSP/Lineage SetupWizard intentionally has no Google SetupCompat service. Treat that as
+      // a supported terminal state instead of performing a failing bind for every activity.
+      swapServiceContextAndNotify(new ServiceContext(State.SERVICE_NOT_USABLE));
+      return;
+    }
