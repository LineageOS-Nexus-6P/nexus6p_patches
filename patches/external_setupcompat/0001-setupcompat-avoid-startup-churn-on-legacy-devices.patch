+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.google.android.setupcompat.partnerconfig;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.IContentProvider;
+import android.content.pm.PackageManager;
+import android.content.pm.ProviderInfo;
+import android.test.mock.MockContentResolver;
+import android.test.mock.MockContext;
+import android.test.mock.MockPackageManager;
+
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+@RunWith(AndroidJUnit4.class)
+public class PartnerConfigHelperTest {
+  @Test
+  public void missingPartnerProviderUsesFallbackWithoutResolverCalls() {
+    PartnerConfigHelper.resetInstance();
+    CountingContentResolver contentResolver = new CountingContentResolver();
+    MissingProviderContext context = new MissingProviderContext(contentResolver);
+
+    assertTrue(PartnerConfigHelper.isSetupWizardDayNightEnabled(context));
+    assertTrue(PartnerConfigHelper.isSetupWizardDayNightEnabled(context));
+    assertEquals(0, contentResolver.acquireCount);
+    assertEquals(1, context.packageManager.resolveCount);
+  }
+
+  @Test
+  public void resetInstanceClearsMissingProviderCache() {
+    PartnerConfigHelper.resetInstance();
+    MissingProviderContext firstContext =
+        new MissingProviderContext(new CountingContentResolver());
+    MissingProviderContext secondContext =
+        new MissingProviderContext(new CountingContentResolver());
+
+    assertTrue(PartnerConfigHelper.isSetupWizardDayNightEnabled(firstContext));
+    PartnerConfigHelper.resetInstance();
+    assertTrue(PartnerConfigHelper.isSetupWizardDayNightEnabled(secondContext));
+
+    assertEquals(1, firstContext.packageManager.resolveCount);
+    assertEquals(1, secondContext.packageManager.resolveCount);
+  }
+
+  private static final class MissingProviderContext extends MockContext {
+    private final ContentResolver contentResolver;
+    private final MissingProviderPackageManager packageManager =
+        new MissingProviderPackageManager();
+
+    MissingProviderContext(ContentResolver contentResolver) {
+      this.contentResolver = contentResolver;
+    }
+
+    @Override
+    public ContentResolver getContentResolver() {
+      return contentResolver;
+    }
+
+    @Override
+    public PackageManager getPackageManager() {
+      return packageManager;
+    }
+  }
+
+  private static final class MissingProviderPackageManager extends MockPackageManager {
+    int resolveCount;
+
+    @Override
+    public ProviderInfo resolveContentProvider(String name, int flags) {
+      resolveCount++;
+      return null;
+    }
+  }
+
+  private static final class CountingContentResolver extends MockContentResolver {
+    int acquireCount;
+
+    @Override
+    protected IContentProvider acquireProvider(Context context, String name) {
+      acquireCount++;
+      return null;
+    }
+  }
+}
