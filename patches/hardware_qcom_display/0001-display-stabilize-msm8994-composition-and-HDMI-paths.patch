         (!strncasecmp(property,"true", PROPERTY_VALUE_MAX )))) {
         sEnabled = true;
@@ -146,7 +146,7 @@ bool MDPComp::init(hwc_context_t *ctx) {
     qdutils::MDPVersion &mdpVersion = qdutils::MDPVersion::getInstance();
 
     sMaxPipesPerMixer = (int)mdpVersion.getBlendStages();
