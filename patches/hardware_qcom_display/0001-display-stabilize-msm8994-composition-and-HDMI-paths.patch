+    if(property_get("persist.vendor.hwc.mdpcomp.maxpermixer", property, "-1") > 0) {
         int val = atoi(property);
         if(val >= 0)
             sMaxPipesPerMixer = min(val, sMaxPipesPerMixer);
@@ -156,7 +156,7 @@ bool MDPComp::init(hwc_context_t *ctx) {
      * doesn't exist, default to 1. Using the property it can be set to 0 or
